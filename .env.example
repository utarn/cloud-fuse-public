# Copy to .env and fill in.  Use the lower-case form of your Google email.
CLOUD_FUSE_ACCOUNT=you@gmail.com
CLOUD_FUSE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
CLOUD_FUSE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET

# Login used when Finder / File Explorer connect to the SMB share.
# Change the password, then pass the same value to docker/macos-mount.sh:
#   CLOUD_FUSE_SMB_PASSWORD=... ./docker/macos-mount.sh
SMB_USER=cloudfuse
SMB_PASSWORD=cloudfuse

RUST_LOG=info
